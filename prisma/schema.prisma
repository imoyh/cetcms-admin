// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator graphql {
  provider = "prisma-nestjs-graphql"
  output   = "../src/generated/graphql"
  prettier = "true"
}

generator dto {
  provider                        = "prisma-generator-nestjs-dto"
  output                          = "../src/generated/dto"
  outputToNestJsResourceStructure = "false"
  flatResourceStructure           = "false"
  exportRelationModifierClasses   = "false"
  reExport                        = "false"
  createDtoPrefix                 = "Create"
  updateDtoPrefix                 = "Update"
  dtoSuffix                       = "Dto"
  entityPrefix                    = ""
  entitySuffix                    = "Model"
  classValidation                 = "false"
  fileNamingStyle                 = "kebab"
  noDependencies                  = "false"
  outputType                      = "class"
  definiteAssignmentAssertion     = "false"
  requiredResponseApiProperty     = "false"
  prettier                        = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id   Int    @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String @unique @default(cuid())

  email String @unique

  /// @HideField({ output: true })
  password String

  firstName String @map("first_name")
  lastName  String @map("last_name")

  roleId Int?       @map("role_id")
  role   AdminRole? @relation(fields: [roleId], references: [id])

  /// @HideField({ match: '(Create|Update)*Input' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '(Create|Update)*Input' })
  updatedAt DateTime @updatedAt @map("updated_at")

  auths   Auth[]
  files   MediaFile[]
  folders MediaFolderBelong[]

  @@map("admins")
}

model AdminRole {
  id   Int    @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String @unique @default(cuid())

  name        String  @unique
  displayName String? @map("display_name")
  description String?

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  admins Admin[]

  @@map("admin_roles")
}

model User {
  id   Int    @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String @unique @default(cuid())

  email    String @unique
  /// @HideField({ output: true })
  password String

  firstName String @map("first_name")
  lastName  String @map("last_name")

  roleId Int?      @map("role_id")
  role   UserRole? @relation(fields: [roleId], references: [id])

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  auths   Auth[]
  files   MediaFile[]
  folders MediaFolderBelong[]

  @@map("users")
}

model UserRole {
  id   Int    @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String @unique @default(cuid())

  name        String  @unique
  displayName String? @map("display_name")
  description String?

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("user_roles")
}

model Auth {
  id   Int    @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String @unique @default(cuid())

  /// @HideField({ input: true, output: true })
  token          String   @unique
  /// @HideField({ match: '@(*Create*|*Update*)' })
  tokenEnabledAt DateTime @map("token_enabled_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  tokenCreatedAt DateTime @map("token_created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  tokenExpiresAt DateTime @map("token_expires_at")

  userId Int?  @map("user_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  user   User? @relation(fields: [userId], references: [id])

  adminId Int?   @map("admin_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  admin   Admin? @relation(fields: [adminId], references: [id])

  /// @HideField({ match: '@(*Create*|*Update*)' })
  userType AuthUserType? @map("auth_user_type")

  /// @HideField({ match: '@(*Create*|*Update*)' })
  loginIp String?   @map("login_ip")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  loginAt DateTime? @map("login_at")

  clientId Int?    @map("client_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  client   Client? @relation(fields: [clientId], references: [id])

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("auths")
}

enum AuthUserType {
  USER
  ADMIN
}

model Client {
  id   Int    @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String @unique @default(cuid())

  name        String  @unique
  title       String?
  description String?
  logo        Json?
  url         String?

  allowAdminAuth Boolean @default(false)
  allowUserAuth  Boolean @default(false)

  isEnabled Boolean @default(false)
  isTesting Boolean @default(false)

  maxAuthCount Int @default(1) @map("max_auth_count")

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  auths     Auth[]
  languages ClientLanguage[]
  menus     ClientMenu[]
  files     MediaFile[]
  folders   MediaFolderBelong[]

  @@map("clients")
}

model ClientLanguage {
  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  languageId Int
  language   Language @relation(fields: [languageId], references: [id])

  alias String

  @@id([clientId, languageId])
  @@map("client_languages")
}

model ClientMenu {
  id   Int     @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String  @unique @default(cuid())
  name String? @unique

  label  String
  icon   String?
  url    String?
  target ClientMenuTarget @default(SELF)

  clientId Int?    @map("client_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  client   Client? @relation(fields: [clientId], references: [id])

  parentId Int?         @map("parent_id")
  parent   ClientMenu?  @relation("client_menu", fields: [parentId], references: [id])
  children ClientMenu[] @relation("client_menu")

  @@map("client_menus")
}

enum ClientMenuTarget {
  SELF
  BLANK
}

model Language {
  id   Int    @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String @unique @default(cuid())

  flag        String
  sign        String
  description String?

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  clients ClientLanguage[]

  @@map("languages")
}

model MediaFolderBelong {
  id    Int            @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid  String         @unique @default(cuid())
  depth Int            @default(0)
  path  String
  store MediaStoreType @default(LOCAL)

  folderId Int
  /// @HideField({ match: '@(*Create*|*Update*)' })
  folder   MediaFolder @relation(fields: [folderId], references: [id])

  userId Int?  @map("user_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  user   User? @relation(fields: [userId], references: [id])

  adminId Int?   @map("admin_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  admin   Admin? @relation(fields: [adminId], references: [id])

  clientId Int?    @map("client_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  client   Client? @relation(fields: [clientId], references: [id])

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([path])
  @@map("media_folder_belongs")
}

model MediaFolder {
  id          Int            @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid        String         @unique @default(cuid())
  store       MediaStoreType @default(LOCAL)
  path        String         @unique
  name        String
  title       String?
  description String?

  depth    Int?          @default(0)
  parentId Int?          @map("parent_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  parent   MediaFolder?  @relation("media_folder", fields: [parentId], references: [id])
  /// @HideField({ match: '@(*Create*|*Update*)' })
  children MediaFolder[] @relation("media_folder")

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  files  MediaFile[]
  belong MediaFolderBelong[]

  @@unique([store, path], name: "storePath")
  @@unique([store, parentId, name], name: "storePathName")
  @@map("media_folders")
}

model MediaFile {
  id   Int    @id @default(autoincrement())
  /// @HideField({ match: '@(*Create*|*Update*)' })
  uuid String @unique @default(cuid())

  fileName String        @map("file_name")
  fileType MediaFileType @default(OTHER) @map("file_type")
  fileExt  String        @map("file_ext")
  fileMime String        @map("file_mime")
  fileSize Int           @map("file_size")
  fileMeta Json?         @map("file_meta")

  folderId Int?         @map("folder_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  folder   MediaFolder? @relation(fields: [folderId], references: [id])

  store       MediaStoreType @default(LOCAL)
  path        String         @map("path")
  title       String?
  description String?

  userId Int?  @map("user_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  user   User? @relation(fields: [userId], references: [id])

  adminId Int?   @map("admin_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  admin   Admin? @relation(fields: [adminId], references: [id])

  clientId Int?    @map("client_id")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  client   Client? @relation(fields: [clientId], references: [id])

  /// @HideField({ match: '@(*Create*|*Update*)' })
  createdAt DateTime @default(now()) @map("created_at")
  /// @HideField({ match: '@(*Create*|*Update*)' })
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media_files")
}

enum MediaStoreType {
  LOCAL
  HUAWEI
  ALYUN
  OTHER
}

enum MediaFileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}
